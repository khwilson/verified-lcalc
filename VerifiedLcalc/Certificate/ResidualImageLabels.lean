module

public import Mathlib.Data.ZMod.Basic
public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs

/-! # Sutherland labels for residual Galois images

The generators below describe conjugacy classes in the indicated `GL₂(𝔽ₚ)`.
See Section 6.4 and Table 3 of Andrew V. Sutherland, *Computing images of
Galois representations attached to elliptic curves*, doi:10.1017/fms.2015.33.
-/

@[expose] public section

namespace VerifiedLcalc

/-- A matrix in row-major order, with entries represented by least nonnegative residues. -/
def galoisMatrixRow {p : ℕ} (g : Matrix.GeneralLinearGroup (Fin 2) (ZMod p)) :
    ℕ × ℕ × ℕ × ℕ :=
  let m := (g : Matrix (Fin 2) (Fin 2) (ZMod p))
  ((m 0 0).val, (m 0 1).val, (m 1 0).val, (m 1 1).val)

/-- Reference generators for the supported Sutherland labels. Each value specifies
the prime and a representative of the subgroup up to conjugacy. -/
def residualImageLabelGenerators : String → Option (ℕ × List (ℕ × ℕ × ℕ × ℕ))
  | "2Cs" => some (2, [(1, 0, 0, 1)])
  | "2B" => some (2, [(1, 1, 0, 1)])
  | "2Cn" => some (2, [(0, 1, 1, 1)])
  | "2G" => some (2, [(1, 1, 0, 1), (1, 0, 1, 1)])
  | "7B.2.3" => some (7, [(2, 0, 0, 4), (3, 0, 0, 1), (1, 1, 0, 1)])
  | _ => none

/-- The subgroup generated by the invertible matrices with the specified row encodings. -/
def residualImageReferenceGroup (p : ℕ) (rows : List (ℕ × ℕ × ℕ × ℕ)) :
    Subgroup (Matrix.GeneralLinearGroup (Fin 2) (ZMod p)) :=
  Subgroup.closure {g | galoisMatrixRow g ∈ rows}

end VerifiedLcalc
