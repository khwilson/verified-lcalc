module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.GroupTheory.Torsion

/-!
# Torsion from independent cyclic subgroups of orders two and n

The generic splitting argument is multiplicative and translates to additive groups.
The finite nonmembership test and the `ZMod` presentations provide the additive API
used by the elliptic-curve certificate.
-/

@[expose] public section

namespace VerifiedLcalc.EllipticCurve

/-- Test whether the supplied element lies outside the cyclic subgroup generated by `Q`. -/
@[to_additive outsideCyclicCheck]
def outsideCyclicCheckMul {G : Type*} [Monoid G] [DecidableEq G]
    (P Q : G) (n : ℕ) : Bool :=
  (List.range n).all (fun k => decide (Q ^ k ≠ P))

variable {G : Type*} [CommGroup G] {P Q : G} {n : ℕ}

/-- A checked finite power search proves multiplicative subgroup nonmembership. -/
@[to_additive outsideCyclicCheck_sound]
theorem outsideCyclicCheckMul_sound [DecidableEq G] (hn : 0 < n)
    (hQ : orderOf Q = n) (h : outsideCyclicCheckMul P Q n = true) :
    P ∉ Subgroup.zpowers Q := by
  intro hmem
  have hfin := orderOf_pos_iff.mp (hQ.symm ▸ hn)
  obtain ⟨k, hk, hkp⟩ := Finset.mem_image.mp
    (hfin.mem_zpowers_iff_mem_range_orderOf.mp hmem)
  have hk' : k < n := hQ ▸ Finset.mem_range.mp hk
  exact of_decide_eq_true (List.all_eq_true.mp h k (List.mem_range.mpr hk')) hkp

/-- An element of order two generates a subgroup disjoint from any cyclic subgroup
that does not contain it. -/
@[to_additive]
private theorem disjoint_zpowers_of_order_two (hP : orderOf P = 2)
    (hout : P ∉ Subgroup.zpowers Q) :
    Disjoint (Subgroup.zpowers P) (Subgroup.zpowers Q) := by
  classical
  apply Subgroup.disjoint_def.mpr
  intro x hxP hxQ
  have hfin := orderOf_pos_iff.mp (hP.symm ▸ (by decide : 0 < (2 : ℕ)))
  obtain ⟨k, hk, hkp⟩ := Finset.mem_image.mp
    (hfin.mem_zpowers_iff_mem_range_orderOf.mp hxP)
  have hk' : k < 2 := hP ▸ Finset.mem_range.mp hk
  obtain rfl | rfl : k = 0 ∨ k = 1 := by omega
  · simpa only [pow_zero] using hkp.symm
  · have hpx : P = x := by simpa only [pow_one] using hkp
    exact (hout (hpx.symm ▸ hxQ)).elim

set_option linter.style.haveILetI false in
/-- Split a finite commutative group from two disjoint finite subgroups whose
product order has the full group's order as a divisor. -/
@[to_additive addEquivProdOfDisjointSubgroups]
theorem mulEquivProdOfDisjointSubgroups (H K : Subgroup G)
    (hdisjoint : Disjoint H K) (hH : 0 < Nat.card H) (hK : 0 < Nat.card K)
    (hbound : Nat.card G ∣ Nat.card H * Nat.card K) :
    ∃ e : H × K ≃* G, ∀ x y, e (x, y) = x * y := by
  have hprod : 0 < Nat.card H * Nat.card K := Nat.mul_pos hH hK
  letI : Finite H := Nat.finite_of_card_ne_zero hH.ne'
  letI : Finite K := Nat.finite_of_card_ne_zero hK.ne'
  letI : Finite G := Nat.finite_of_card_ne_zero (by
    intro hzero
    rw [hzero, zero_dvd_iff] at hbound
    exact hprod.ne' hbound)
  have hle : Nat.card G ≤ Nat.card (H × K) := by
    rw [Nat.card_prod]
    exact Nat.le_of_dvd hprod hbound
  let multiplication := H.subtype.coprod K.subtype
  have hinjective : Function.Injective multiplication := Subgroup.mul_injective_of_disjoint hdisjoint
  let e : H × K ≃* G := MulEquiv.ofBijective multiplication
    (hinjective.bijective_of_nat_card_le hle)
  refine ⟨e, ?_⟩
  intro x y
  rfl

/-- Convert a generator of `G`'s cyclic subgroup to a `ZMod` presentation. -/
private noncomputable def zmodMulEquivPowers {G : Type*} [Group G] (P : G) {n : ℕ}
    (hP : orderOf P = n) : Multiplicative (ZMod n) ≃* Subgroup.zpowers P := by
  let generator : Subgroup.zpowers P := ⟨P, Subgroup.mem_zpowers P⟩
  apply zmodMulEquivOfGenerator (g := generator)
  · intro x
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp x.property
    exact Subgroup.mem_zpowers_iff.mpr ⟨k, Subtype.ext hk⟩
  · exact (Nat.card_zpowers P).trans hP

private theorem zmodMulEquivPowers_one {G : Type*} [Group G] (P : G) {n : ℕ}
    (hP : orderOf P = n) :
    (zmodMulEquivPowers P hP (Multiplicative.ofAdd 1) : G) = P := by
  unfold zmodMulEquivPowers
  rw [zmodMulEquivOfGenerator_apply_ofAdd_one]

/-- An order-two element outside the subgroup generated by an element of order `n`
gives a product presentation when the full torsion order divides `2 * n`. -/
theorem exists_torsion_mulEquiv_two_factor (hn : 0 < n) (hP : orderOf P = 2)
    (hQ : orderOf Q = n) (hout : P ∉ Subgroup.zpowers Q)
    (hbound : Nat.card (CommGroup.torsion G) ∣ 2 * n) :
    ∃ e : Multiplicative (ZMod 2) × Multiplicative (ZMod n) ≃*
        CommGroup.torsion G,
      (e (Multiplicative.ofAdd 1, Multiplicative.ofAdd 0) : G) = P ∧
      (e (Multiplicative.ofAdd 0, Multiplicative.ofAdd 1) : G) = Q := by
  let torsion := CommGroup.torsion G
  have hmemP : P ∈ torsion :=
    (CommGroup.mem_torsion P).mpr (orderOf_pos_iff.mp (hP.symm ▸ (by decide)))
  have hmemQ : Q ∈ torsion :=
    (CommGroup.mem_torsion Q).mpr (orderOf_pos_iff.mp (hQ.symm ▸ hn))
  let p : torsion := ⟨P, hmemP⟩
  let q : torsion := ⟨Q, hmemQ⟩
  have hp : orderOf p = 2 := (Subgroup.orderOf_mk P hmemP).trans hP
  have hq : orderOf q = n := (Subgroup.orderOf_mk Q hmemQ).trans hQ
  have hout' : p ∉ Subgroup.zpowers q := by
    intro h
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp h
    exact hout (Subgroup.mem_zpowers_iff.mpr ⟨k, congrArg Subtype.val hk⟩)
  have hdisjoint : Disjoint (Subgroup.zpowers p) (Subgroup.zpowers q) :=
    disjoint_zpowers_of_order_two hp hout'
  have hH : 0 < Nat.card (Subgroup.zpowers p) := by rw [Nat.card_zpowers, hp]; decide
  have hK : 0 < Nat.card (Subgroup.zpowers q) := by rw [Nat.card_zpowers, hq]; exact hn
  obtain ⟨split, hsplit⟩ := mulEquivProdOfDisjointSubgroups
    (Subgroup.zpowers p) (Subgroup.zpowers q) hdisjoint hH hK (by
      rw [Nat.card_zpowers, hp, Nat.card_zpowers, hq]
      exact hbound)
  let e := (zmodMulEquivPowers p hp).prodCongr (zmodMulEquivPowers q hq) |>.trans split
  refine ⟨e, ?_, ?_⟩
  · change ((split (zmodMulEquivPowers p hp (Multiplicative.ofAdd 1),
      zmodMulEquivPowers q hq (Multiplicative.ofAdd 0)) : torsion) : G) = P
    rw [hsplit]
    simp [zmodMulEquivPowers_one, p, q]
  · change ((split (zmodMulEquivPowers p hp (Multiplicative.ofAdd 0),
      zmodMulEquivPowers q hq (Multiplicative.ofAdd 1)) : torsion) : G) = Q
    rw [hsplit]
    simp [zmodMulEquivPowers_one, p, q]

/-- Convert the multiplicative torsion subgroup of an additive group back to its
additive torsion subgroup. -/
private def torsionMulEquiv {A : Type*} [AddCommGroup A] :
    CommGroup.torsion (Multiplicative A) ≃* Multiplicative (AddCommGroup.torsion A) where
  toFun x := Multiplicative.ofAdd ⟨Multiplicative.toAdd x.val,
    (AddCommGroup.mem_torsion _).mpr ((isOfFinOrder_ofAdd_iff).mp x.property)⟩
  invFun x := ⟨Multiplicative.ofAdd x.toAdd,
    (isOfFinOrder_ofAdd_iff).mpr ((AddCommGroup.mem_torsion _).mp x.property)⟩
  left_inv x := by apply Subtype.ext; rfl
  right_inv x := by apply Subtype.ext; rfl
  map_mul' x y := rfl

/-- An order-two point outside the subgroup of an order-`n` point gives the
claimed product structure when `2 * n` is also a divisor bound for the full group. -/
theorem exists_torsion_addEquiv_two_factor {A : Type*} [AddCommGroup A] {P Q : A} {n : ℕ}
    (hn : 0 < n) (hP : addOrderOf P = 2)
    (hQ : addOrderOf Q = n) (hout : P ∉ AddSubgroup.zmultiples Q)
    (hbound : Nat.card (AddCommGroup.torsion A) ∣ 2 * n) :
    ∃ e : ZMod 2 × ZMod n ≃+ AddCommGroup.torsion A,
      (e (1, 0) : A) = P ∧ (e (0, 1) : A) = Q := by
  have hP' : orderOf (Multiplicative.ofAdd P) = 2 := by simpa using hP
  have hQ' : orderOf (Multiplicative.ofAdd Q) = n := by simpa using hQ
  have hout' : Multiplicative.ofAdd P ∉
      Subgroup.zpowers (Multiplicative.ofAdd Q) := by
    intro h
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp h
    apply hout
    exact AddSubgroup.mem_zmultiples_iff.mpr ⟨k, by simpa using congrArg Multiplicative.toAdd hk⟩
  have hcard : Nat.card (CommGroup.torsion (Multiplicative A)) =
      Nat.card (AddCommGroup.torsion A) := Nat.card_congr torsionMulEquiv.toEquiv
  obtain ⟨e, heP, heQ⟩ := exists_torsion_mulEquiv_two_factor
    (G := Multiplicative A) hn hP' hQ' hout' (hcard ▸ hbound)
  let src : Multiplicative (ZMod 2 × ZMod n) ≃*
      Multiplicative (ZMod 2) × Multiplicative (ZMod n) :=
    MulEquiv.prodMultiplicative (ZMod 2) (ZMod n)
  let ea : ZMod 2 × ZMod n ≃+ AddCommGroup.torsion A :=
    AddEquiv.toMultiplicative.symm ((src.trans e).trans (torsionMulEquiv (A := A)))
  refine ⟨ea, ?_, ?_⟩
  · change Multiplicative.toAdd (e (Multiplicative.ofAdd 1,
      Multiplicative.ofAdd 0)).val = P
    exact congrArg Multiplicative.toAdd heP
  · change Multiplicative.toAdd (e (Multiplicative.ofAdd 0,
      Multiplicative.ofAdd 1)).val = Q
    exact congrArg Multiplicative.toAdd heQ

end VerifiedLcalc.EllipticCurve
