# Copy to a private .env file; uv does not load it unless UV_ENV_FILE=.env is set.
REGISTRY_DATABASE_URL=postgresql+psycopg://registry:registry@127.0.0.1:5432/lcalc_registry
REGISTRY_DATA_DIR=.registry-state
# Replace with a long random token. Never commit real credentials.
REGISTRY_API_TOKEN=replace-with-a-random-operator-token
# Set the exact public HTTP Host header when deploying MCP behind HTTPS.
REGISTRY_MCP_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# Enable only when serving the public LMFDB proof-request button.
REGISTRY_PUBLIC_PROOF_REQUESTS=0
REGISTRY_PUBLIC_MAX_PENDING=64
REGISTRY_PROOF_ORIGINS=https://www.lmfdb.org,https://lmfdb.org
